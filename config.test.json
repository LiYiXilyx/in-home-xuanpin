{
  "$schema": "./config.schema.json",
  "app": {
    "environment": "test",
    "databasePath": "./data/test/temu_research_test.db",
    "legacyDatabasePath": "./data/test/legacy_unused.db",
    "backupDir": "./backups/test",
    "logDir": "./logs/test"
  },
  "browser": {
    "mode": "external_cdp",
    "profileDir": "./browser-profile-test-unused",
    "headless": false,
    "executablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "cdpEndpoint": "http://127.0.0.1:9222",
    "debugPort": 9222,
    "locale": "en-DE",
    "minimumDelayMs": 1500,
    "maximumDelayMs": 3000,
    "manualGateTimeoutMs": 1800000,
    "manualGatePollMs": 500,
    "heartbeatIntervalMs": 5000,
    "heartbeatTimeoutMs": 30000,
    "closeLaunchedBrowserOnExit": false,
    "minimumCatalogCount": 50
  },
  "catalog": {
    "siteCountry": "德国",
    "language": "en",
    "currency": "EUR",
    "exchangeRateRmb": 8,
    "targetCount": 100,
    "capture": {
      "minSafeCount": 100,
      "maxStaleRounds": 10,
      "maxExpansions": 10,
      "minimumDelayMs": 1500,
      "maximumDelayMs": 3000,
      "imageMinimumBytes": 1024,
      "imageTimeoutMs": 30000,
      "imageConcurrency": 3
    },
    "selectionRules": {
      "minPriceEur": 5,
      "minRating": 4.6,
      "minRecentDailyReviews": 3,
      "excludeElectronic": true,
      "excludeUsb": true,
      "electronicTerms": ["battery", "rechargeable", "bluetooth", "wireless", "charger", "electronic", "lithium", "led light", "电池", "充电", "蓝牙", "无线", "电子"],
      "usbTerms": ["usb", "type-c", "type c"]
    },
    "jobs": [{
      "url": "https://www.temu.com/de-en/motorcycles--accessories-o3-585.html",
      "primaryCategory": "Automotive",
      "subcategory": "Motorcycles & Powersports Accessories",
      "sortOrder": "Top Sales",
      "searchQuery": "motorcycle parts",
      "targetCount": 100
    }],
    "selectors": {
      "productLinks": "a[href*='goods.html'], a[href*='-g-']",
      "productCard": "[data-testid*='product'], [class*='product-card'], [class*='ProductCard'], li",
      "reviewOpen": "button:has-text('See all reviews')",
      "reviewSort": "button:has-text('Most recent')",
      "reviewCard": "[data-testid*='review-item'], [class*='reviewItem'], [class*='review-item']",
      "reviewDate": "time, [class*='date'], [data-testid*='date']",
      "reviewText": "[data-testid*='review-content'], [class*='review-content'], [class*='reviewContent']",
      "reviewRating": "[aria-label*='out of 5'], [aria-label*='star'], [class*='star']",
      "reviewLoadMore": "button:has-text('Load more'), button:has-text('Show more')"
    }
  },
  "export": {
    "outputDir": "./outputs/test-run",
    "imageCacheDir": "./outputs/test-run/image-cache"
  },
  "reviews": {
    "enabled": false,
    "negativeMaxRating": 3,
    "pilotBatchSize": 10,
    "minimumPilotSuccess": 8,
    "pilotFullHistory": true,
    "fastGrowthRatio": 1.5
  }
}
